{
  "name": "erpsaver-backend",
  "version": "1.0.0",
  "description": "ERPsaver Backend API - Singapore ERP optimization & parking discovery",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "sync:erp": "tsx src/scripts/syncErpStatic.ts",
    "sync:datamall": "tsx scripts/sync-datamall.ts",
    "check:erp-freshness": "tsx src/scripts/checkErpFreshness.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@turf/turf": "^7.4.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "tsx": "^4.15.0",
"typescript": "5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  }
}
